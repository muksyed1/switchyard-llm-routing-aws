global:
    scrape_interval: {{ prometheus_scrape_interval | default('15s') }}

scrape_configs:
  - job_name: 'switchyard'
    static_configs:
      - targets: [ "{{ ansible_default_ipv4.address }}:{{ switchyard_port }}" ]
        labels:
          instance: "demo-gateway"

  - job_name: node
    static_configs:
{% for host in groups['all'] %}
      - targets: ["{{ hostvars[host].ansible_default_ipv4.address }}:9100"]
        labels:
          instance: "{{ host }}"
{% endfor %}